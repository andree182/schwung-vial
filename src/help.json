{
  "title": "Vial",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Vial polyphonic",
        "wavetable synth",
        "(Vital engine).",
        "",
        "3 wavetable oscs,",
        "1 sampler/noise,",
        "2 multi-mode filters,",
        "3 envelopes, LFOs,",
        "and 7 FX units.",
        "",
        "Loads .vital/.vial,",
        ".helm, and Surge XT",
        ".fxp presets."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Knob Mapping",
          "lines": [
            "Knob 1: F1 Cutoff",
            " Filter 1 cutoff",
            "",
            "Knob 2: F1 Res",
            " Filter 1 resonance",
            "",
            "Knob 3: F1 Drive",
            " Filter 1 drive",
            "",
            "Knob 4: Attack",
            "Knob 5: Decay",
            "Knob 6: Sustain",
            "Knob 7: Release",
            " Amp envelope ADSR",
            "",
            "Knob 8: Volume",
            " Global volume"
          ]
        },
        {
          "title": "Presets",
          "lines": [
            "Turn jog wheel at",
            "root to browse.",
            "",
            "Use Jump to Category",
            "to jump between:",
            " Vial-* (.vital)",
            " Helm-* (.helm)",
            " Surge-* (.fxp)"
          ]
        },
        {
          "title": "Oscillators",
          "lines": [
            "Osc 1, 2 & 3 have:",
            " On/Off, Level,",
            " Transpose, Tune,",
            " Pan, Unison Voices,",
            " Detune, Wave Frame,",
            " Phase/FM Distortion,",
            " Spectral Morph, and",
            " Routing Destination.",
            "",
            "Sampler / Noise:",
            " Level, Transpose,",
            " Tune, Pan, Loop."
          ]
        },
        {
          "title": "Filters",
          "lines": [
            "Filter 1 & Filter 2",
            "with controls for:",
            " On/Off, Model,",
            " Style, Cutoff,",
            " Resonance, Drive,",
            " Blend, Mix,",
            " Keytrack, and",
            " Osc/Sample inputs."
          ]
        },
        {
          "title": "Envelopes",
          "lines": [
            "3 ADSR Envelopes:",
            " Amp Envelope (Env1)",
            " Envelope 2",
            " Envelope 3",
            "",
            "Adjust Attack,",
            "Decay, Sustain,",
            "Release, Delay,",
            "and Hold."
          ]
        },
        {
          "title": "LFOs & Macros",
          "lines": [
            "LFO 1 & LFO 2:",
            " Frequency, Sync,",
            " Tempo, Sync Type,",
            " Phase, Fade In,",
            " Smooth Time.",
            "",
            "Macros:",
            " Macro Controls 1-4."
          ]
        },
        {
          "title": "Effects",
          "lines": [
            "7 built-in effects:",
            " Chorus",
            " Flanger",
            " Phaser",
            " Distortion",
            " Delay",
            " Reverb",
            " Compressor",
            "",
            "Enable and tweak",
            "each effect in its",
            "respective menu."
          ]
        }
      ]
    },
    {
      "title": "Settings",
      "lines": [
        "CPU & Engine:",
        " Oversampling (1x-8x)",
        " Multi-Core (Off/On)",
        " FFT Cache (On/Off)",
        " Max Polyphony (1-16)",
        " Max Unison (1-16)",
        " Bypass FX (Off/On)",
        "",
        "Global:",
        " BPM & Auto BPM",
        " Volume, Polyphony",
        " Portamento & Legato",
        " Pitch Bend & Vel"
      ]
    }
  ]
}
